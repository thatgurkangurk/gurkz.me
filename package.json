	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "nub node_modules/drizzle-kit/bin.cjs --config ./drizzle.config.ts push",
		"db:generate": "nub node_modules/drizzle-kit/bin.cjs --config ./drizzle.config.ts generate",
		"db:migrate": "nub node_modules/drizzle-kit/bin.cjs --config ./drizzle.config.ts migrate",
		"db:studio": "nub node_modules/drizzle-kit/bin.cjs --config ./drizzle.config.ts studio",
		"auth:schema": "auth generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/schema/auth.ts --yes"
	},
	"type": "module",
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
